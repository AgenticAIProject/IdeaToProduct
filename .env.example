# ── LLM Configuration & Multi-Provider Architecture ───────────────────────────

# 1. Google Gemini (Used for simple tasks: Review, Documentation, Clarification, Requirements)
# Multiple Gemini keys can be provided either comma-separated or as numbered keys (GOOGLE_API_KEY_1, GOOGLE_API_KEY_2, ...)
GOOGLE_API_KEY=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
GEMINI_MODEL=gemini-3.8-flash

# 2. DeepSeek (Used for Code Agent)
# API key from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CODE_MODEL=deepseek-chat

# 3. Groq (Ultra-fast inference for Design/Test and automatic fallback)
# Free API key from Groq Console: https://console.groq.com/keys (starts with gsk_...)
# Multiple Groq keys are supported (comma-separated or GROQ_API_KEY_2, GROQ_API_KEY_3, ...)
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=openai/gpt-oss-120b

# 4. Optional per-agent overrides (defaults to: code->deepseek, docs/review/req->gemini, design/test->groq)
# PROVIDER_CODE=deepseek
# PROVIDER_DOCUMENTATION=google
# PROVIDER_REVIEW=google
# PROVIDER_REQUIREMENT=google
# PROVIDER_DESIGN=groq
# PROVIDER_TEST=groq

LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
